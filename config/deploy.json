{
  "_comment": "Deployment configuration for Ollama Automation Harness",
  "_docs": "See scripts/deploy.py for usage. Environment variables override these settings.",

  "default": {
    "backup_before_deploy": true,
    "run_tests_before_deploy": true,
    "notify_on_complete": false,
    "docker_image": "ollama-harness",
    "docker_tag": "latest",
    "pypi_repository": "pypi"
  },

  "development": {
    "backup_before_deploy": false,
    "run_tests_before_deploy": false,
    "docker_tag": "dev"
  },

  "staging": {
    "backup_before_deploy": true,
    "run_tests_before_deploy": true,
    "docker_tag": "staging",
    "remote_path": "/opt/ollama-harness-staging"
  },

  "production": {
    "backup_before_deploy": true,
    "run_tests_before_deploy": true,
    "notify_on_complete": true,
    "docker_tag": "latest",
    "remote_path": "/opt/ollama-harness"
  }
}
