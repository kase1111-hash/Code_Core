# =============================================================================
# Testing Environment Configuration
# =============================================================================
# Optimized for automated testing with fast execution

# Environment identifier
ENVIRONMENT=testing

# Enable debug for test diagnostics
DEBUG=true

# =============================================================================
# Model Configuration (Testing)
# =============================================================================
# Mock or minimal models for speed

OLLAMA_MODEL=llama3
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=1024

# =============================================================================
# Timeouts (Testing)
# =============================================================================
# Short timeouts for fast test execution

OLLAMA_TIMEOUT=10
COMMAND_TIMEOUT=5

# =============================================================================
# Retry Configuration (Testing)
# =============================================================================
# Minimal retries for fast failure detection

MAX_RETRIES=1
RETRY_DELAY=0.1

# =============================================================================
# Logging (Testing)
# =============================================================================
# Debug logging to capture test issues

LOG_LEVEL=DEBUG
LOG_FORMAT=verbose
LOG_FILE=./logs/testing.log

# =============================================================================
# Display Settings (Testing)
# =============================================================================

LOOP_DELAY=0.1
MAX_REPLY_LENGTH=1000

# =============================================================================
# Testing-specific Features
# =============================================================================

# Disable hot reload
HOT_RELOAD=false

# Enable detailed error messages
DETAILED_ERRORS=true

# Disable rate limiting for tests
RATE_LIMITING=false

# Enable test mode
TEST_MODE=true

# Use in-memory storage where possible
USE_MEMORY_STORAGE=true

# Disable external service calls
MOCK_EXTERNAL_SERVICES=true
