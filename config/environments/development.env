# =============================================================================
# Development Environment Configuration
# =============================================================================
# Optimized for local development with verbose logging and debugging enabled

# Environment identifier
ENVIRONMENT=development

# Enable debug mode for verbose output
DEBUG=true

# =============================================================================
# Model Configuration (Development)
# =============================================================================
# Use smaller/faster models for quick iteration

OLLAMA_MODEL=llama3
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=4096

# =============================================================================
# Timeouts (Development)
# =============================================================================
# Longer timeouts for debugging

OLLAMA_TIMEOUT=120
COMMAND_TIMEOUT=60

# =============================================================================
# Retry Configuration (Development)
# =============================================================================
# Fewer retries for faster feedback

MAX_RETRIES=2
RETRY_DELAY=0.5

# =============================================================================
# Logging (Development)
# =============================================================================
# Verbose logging for debugging

LOG_LEVEL=DEBUG
LOG_FORMAT=verbose
LOG_FILE=./logs/development.log

# =============================================================================
# Display Settings (Development)
# =============================================================================
# Longer output for debugging

LOOP_DELAY=0.5
MAX_REPLY_LENGTH=5000

# =============================================================================
# Development-specific Features
# =============================================================================

# Enable hot reload for development
HOT_RELOAD=true

# Enable detailed error messages
DETAILED_ERRORS=true

# Disable rate limiting in development
RATE_LIMITING=false

# Enable test mode features
TEST_MODE=true
