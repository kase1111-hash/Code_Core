# Ollama Automation Harness - Environment Variables
# Copy this file to .env and fill in your values

# Anthropic API Key (required for Claude API mode)
# Get your key at: https://console.anthropic.com/
# Leave empty to use Ollama fallback mode
ANTHROPIC_API_KEY=

# Optional: Override default Ollama model
# OLLAMA_MODEL=llama3

# Optional: Override default sandbox directory
# SANDBOX_DIR=./sandbox

# Optional: Override default log file
# LOG_FILE=./logs/automation.log
