# =============================================================================
# Ollama Automation Harness - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env files with real secrets to version control
#
# For environment-specific config, create:
#   .env.development, .env.staging, .env.production
# =============================================================================

# =============================================================================
# Environment
# =============================================================================
# Options: development, staging, production, testing
ENVIRONMENT=development

# Enable debug mode (disable in production!)
DEBUG=false

# =============================================================================
# API Keys & Secrets
# =============================================================================

# Anthropic API Key (optional - falls back to Ollama if not set)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Sentry DSN for error tracking (optional)
# Get your DSN at: https://sentry.io/
SENTRY_DSN=

# Ollama API key for remote Ollama instances (optional)
OLLAMA_API_KEY=

# =============================================================================
# Model Configuration
# =============================================================================

# Default Ollama model for local inference
OLLAMA_MODEL=llama3

# Claude model for API mode
CLAUDE_MODEL=claude-sonnet-4-20250514

# Maximum tokens for Claude response
CLAUDE_MAX_TOKENS=4096

# =============================================================================
# Paths
# =============================================================================

# Sandbox directory for safe file operations
SANDBOX_DIR=./sandbox

# Permissions configuration file
PERMISSIONS_FILE=./config/permissions.yaml

# Log file location
LOG_FILE=./logs/automation.log

# =============================================================================
# Timeouts
# =============================================================================

# Ollama subprocess timeout (seconds)
OLLAMA_TIMEOUT=60

# Command execution timeout (seconds)
COMMAND_TIMEOUT=30

# =============================================================================
# Retry Configuration
# =============================================================================

# Maximum retry attempts for Ollama
MAX_RETRIES=3

# Delay between retries (seconds)
RETRY_DELAY=1.0

# =============================================================================
# Display Settings
# =============================================================================

# Main loop delay between iterations (seconds)
LOOP_DELAY=1.0

# Maximum characters to display from Claude's reply
MAX_REPLY_LENGTH=2000
